# Server
PORT=3000

# Sentiment provider selection: placeholder | inference
# - placeholder: rule-based, no LLM, always available (default)
# - inference: calls an OpenAI-compatible chat completions endpoint, configured
#   below. Works with local Ollama, Groq, or any other OpenAI-compatible API --
#   swap providers by changing INFERENCE_BASE_URL/INFERENCE_MODEL alone, no code
#   changes needed. (Configurable this way at Echory's explicit request, so they
#   can point this backend at an external model if the local/containerized one
#   has problems on their side.)
LLM_PROVIDER=placeholder

# Used when LLM_PROVIDER=inference. Default below is the ticket-0006 winner:
# phi4-mini (3.8B) -- chosen over gemma4:e2b (higher raw accuracy on the
# original 18-case benchmark, but that lead was ~19 points of overfitting per
# a holdout-set check; both converge to 70% on unseen cases) for its
# meaningfully better risk-level accuracy (70% vs 50%), which matters directly
# for the traffic-light UI signal. See docs/benchmark-results.md for the full
# comparison across all three rounds plus the holdout validation.
#
# granite4.1:3b is the documented swap-in alternative (70% accuracy, ~same
# quality, slightly larger latency margin) -- switch to it by changing
# INFERENCE_MODEL alone, no code changes:
#   INFERENCE_MODEL=granite4.1:3b
#
# Both are non-reasoning models, so the default OpenAI-compatible path below
# works cleanly for either -- INFERENCE_DISABLE_THINKING is not needed unless
# a future model choice turns out to require it (ticket 0005/0007).
#
# Cloud (Groq), per Pascal's explicit request that this stay swappable with
# zero code changes if Echory's container has trouble running local inference:
#   INFERENCE_BASE_URL=https://api.groq.com/openai/v1
#   INFERENCE_MODEL=llama-3.3-70b-versatile
#   INFERENCE_API_KEY=your-groq-api-key
INFERENCE_BASE_URL=http://localhost:11434/v1
INFERENCE_MODEL=phi4-mini
INFERENCE_API_KEY=

# Only used by scripts/llm-benchmark.ts (ticket 0006's local model quality
# benchmark) -- NOT required to run the actual backend. An external judge
# (rather than another local model) avoids competing with the models under
# test for the same GPU. DeepSeek's API is OpenAI-compatible.
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_MODEL=deepseek-reasoner
JUDGE_API_KEY=your-deepseek-api-key
