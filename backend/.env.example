# Server
PORT=3000

# Sentiment provider selection: placeholder | local | cloud
# - placeholder: rule-based, no LLM, always available (default)
# - local: Ollama-backed model (implemented in a later phase)
# - cloud: free-tier cloud API fallback, e.g. Groq or Gemini Flash (implemented in a later phase)
LLM_PROVIDER=placeholder

# Used when LLM_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Used when LLM_PROVIDER=cloud
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
