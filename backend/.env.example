# Server
PORT=3000

# Sentiment provider selection: placeholder | inference
# - placeholder: rule-based, no LLM, always available (default)
# - inference: calls an OpenAI-compatible chat completions endpoint, configured
#   below. Works with local Ollama, Groq, or any other OpenAI-compatible API --
#   swap providers by changing INFERENCE_BASE_URL/INFERENCE_MODEL alone, no code
#   changes needed. (Configurable this way at Echory's explicit request, so they
#   can point this backend at an external model if the local/containerized one
#   has problems on their side.)
LLM_PROVIDER=placeholder

# Used when LLM_PROVIDER=inference. Examples:
#
# Local (Ollama's OpenAI-compatible endpoint):
#   INFERENCE_BASE_URL=http://localhost:11434/v1
#   INFERENCE_MODEL=llama3.2:3b
#   INFERENCE_API_KEY=            (not needed for Ollama)
#
# Cloud (Groq):
#   INFERENCE_BASE_URL=https://api.groq.com/openai/v1
#   INFERENCE_MODEL=llama-3.3-70b-versatile
#   INFERENCE_API_KEY=your-groq-api-key
INFERENCE_BASE_URL=http://localhost:11434/v1
INFERENCE_MODEL=llama3.2:3b
INFERENCE_API_KEY=

# Only used by scripts/llm-benchmark.ts (ticket 0006's local model quality
# benchmark) -- NOT required to run the actual backend. An external judge
# (rather than another local model) avoids competing with the models under
# test for the same GPU. DeepSeek's API is OpenAI-compatible.
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_MODEL=deepseek-reasoner
JUDGE_API_KEY=your-deepseek-api-key
